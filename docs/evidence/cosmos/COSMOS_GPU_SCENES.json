    "name": "valley-third-person",
    "expression": "()=>{window.cosmosMeasureWalk=async(x,z)=>{const r=Realm.test.move(x,z);if(!r.ok)throw Error(r.error);const start=performance.now();while(Realm.test.path.length){if(performance.now()-start>45000)throw Error('walk timeout');await new Promise(r=>setTimeout(r,50));}};document.querySelector('[data-rpg=\"camera\"][data-id=\"adventure\"]').click();Realm.test.view({yaw:0,elevation:.28,distance:10});return {scene:Realm.diagnostics.scene};}"
  },
  {
    "name": "cosmos-arrival-third-person",
